FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --default-timeout=100 --no-cache-dir fastapi uvicorn pydantic pyyaml PyJWT python-multipart passlib "bcrypt<5" "psycopg[binary]>=3.2,<4"

# Copy the core engine modules needed for the API
COPY core/ /app/core/
COPY config/ /app/config/

# Note: The data/ folder containing journal.sqlite will be mounted via docker-compose

# Expose the API port
EXPOSE 8080

# Run the API server binding to 0.0.0.0
CMD ["uvicorn", "core.api.server:app", "--host", "0.0.0.0", "--port", "8080"]
