# ATLAX environment template
# Fill in the real values locally. Do not commit your personal .env file.

ATLAX_TELEGRAM_BOT_TOKEN=
ATLAX_TELEGRAM_CHAT_ID=
ATLAX_TELEGRAM_MINI_APP_URL=
ATLAX_DISCORD_WEBHOOK_URL=

ATLAX_AI_API_KEY=
ATLAX_AI_FALLBACK_API_KEY=

ATLAX_MT5_PASSWORD=

ATLAX_DASHBOARD_JWT_SECRET=
ATLAX_WEBHOOK_SECRET=
ATLAX_GOOGLE_SHEETS_WEBHOOK_URL=
ATLAX_GOOGLE_SHEETS_SHARED_SECRET=

# Deployment safety. Keep false until execution has passed the approval gate.
ATLAX_ENV=development
ATLAX_LIVE_TRADING_ENABLED=false

ATLAX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ATLAX_AUTH_COOKIE_SECURE=false
ATLAX_AUTH_COOKIE_SAMESITE=lax
ATLAX_TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900

# Shared PostgreSQL target. Keep local mode until the import is verified.
ATLAX_STORAGE_BACKEND=local
ATLAX_STORAGE_CUTOVER_ENABLED=false
ATLAX_DATABASE_URL=
ATLAX_DATABASE_SSLMODE=require
ATLAX_DATABASE_CONNECT_TIMEOUT_SECONDS=10
ATLAX_POSTGRES_DB=atlax
ATLAX_POSTGRES_USER=atlax
ATLAX_POSTGRES_PASSWORD=

ATLAX_PAYMENTS_ENABLED=true
ATLAX_PAYMENT_PRICE_USD=15
ATLAX_PAYMENT_DURATION_DAYS=30
ATLAX_PAYMENT_DEFAULT_STYLE=day_trader
ATLAX_PAYMENT_REFERENCE_PREFIX=ATLAX
ATLAX_PAYMENT_TTL_HOURS=1
ATLAX_SUBSCRIPTION_EXPIRY_REMINDER_HOURS=72,24
ATLAX_PAYMENT_MANUAL_REVIEW_REQUIRED=true
ATLAX_PAYMENT_SUPPORT_CONTACT=@ocrooxx
ATLAX_CRYPTO_ENABLED=true
ATLAX_CRYPTO_WALLET_ADDRESS=
ATLAX_CRYPTO_NETWORK=USDC-Solana
ATLAX_CRYPTO_ASSET_LABEL=USDC
ATLAX_MPESA_ENABLED=true
ATLAX_MPESA_LIPA_NUMBER=
ATLAX_MPESA_ACCOUNT_REFERENCE=ATLAX15
ATLAX_MPESA_AMOUNT_TZS=
ATLAX_MPESA_AMOUNT_HINT=
ATLAX_USDT_TON_ENABLED=true
ATLAX_USDT_TON_WALLET_ADDRESS=
ATLAX_USDT_TON_NETWORK=TON
ATLAX_USDT_TON_ASSET_LABEL=USDT
ATLAX_SOLANA_ENABLED=true
ATLAX_SOLANA_WALLET_ADDRESS=
ATLAX_SOLANA_NETWORK=Solana
ATLAX_SOLANA_ASSET_LABEL=SOL
  ATLAX_CARD_ENABLED=false
ATLAX_AUTOMATIC_VERIFICATION_ENABLED=false
ATLAX_AUTOMATIC_VERIFICATION_SHADOW_MODE=true
ATLAX_PAYMENT_VERIFICATION_TIMEOUT_SECONDS=15
ATLAX_PAYMENT_VERIFICATION_CLOCK_SKEW_SECONDS=300
ATLAX_TON_VERIFICATION_API_URL=https://toncenter.com/api/v3/jettons/transfers
# Provider credentials and token allowlists stay environment-only.
ATLAX_TON_VERIFICATION_API_KEY=
ATLAX_TON_USDT_JETTON_MASTER=
ATLAX_TON_USDT_DECIMALS=6
ATLAX_SOLANA_VERIFICATION_RPC_URL=
ATLAX_SOLANA_TOKEN_DECIMALS=6
ATLAX_CARD_CHECKOUT_URL=

