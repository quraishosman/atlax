.env
.env.*
!.env.example
config/atlax.local.yaml
config/*.local.yaml

# Runtime state, subscriber/payment data, local databases, and logs.
data/*
!data/.gitkeep
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.log
*.jsonl
recent_trades.json

# Python and local tooling artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration backups created by the atomic Settings writer.
config/*.bak
config/.*.tmp
